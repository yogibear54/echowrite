# Voice Dictation Tool Environment Variables
# Copy this file to .env and fill in your actual values

# Replicate API Token (Required)
# Get your API token from: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=r8_your_api_token_here

# Transcription Provider (default: replicate)
# Supported: replicate, local_whisper
#   replicate      -> uses Replicate's hosted whisper (requires REPLICATE_API_TOKEN)
#   local_whisper  -> uses faster-whisper in-process (no API key, downloads model on first run)
TRANSCRIPTION_PROVIDER=replicate

# Maximum recording duration in minutes (default: 5.0, range: 0.1-60.0)
# Recording will automatically stop when this limit is reached
MAX_RECORDING_MINUTES=5

# Audio sample rate in Hz (default: 44100, range: 8000-48000)
# Common values: 8000, 16000, 44100, 48000
SAMPLE_RATE=44100

# Replicate model name with version tag (default: vaibhavs10/incredibly-fast-whisper:3ab86df6c8f54c11309d4d1f930ac292bad43ace52d10c80d87eb258b3c9f79c)
# The model used for speech transcription
# Note: Version tag is required for API compatibility
REPLICATE_MODEL=vaibhavs10/incredibly-fast-whisper:3ab86df6c8f54c11309d4d1f930ac292bad43ace52d10c80d87eb258b3c9f79c

# Local Whisper settings (only used when TRANSCRIPTION_PROVIDER=local_whisper)
# On first use, faster-whisper downloads the model weights to the Hugging Face cache
# (~/.cache/huggingface/hub/ normally, /root/.cache/huggingface/hub/ when run with sudo).
# Override the cache location with the HF_HOME env var if needed.
#
# Model size — bigger = more accurate but slower to load and run
# Options: tiny | base | small | medium | large-v3 | large-v3-turbo
# Approx boot time on CPU int8: tiny~1s, base~3s, small~5-10s, medium~15-30s, large-v3~30-60s
WHISPER_MODEL_SIZE=small
# Device: cpu (works everywhere) | cuda (requires NVIDIA GPU + CUDA toolkit)
WHISPER_DEVICE=cpu
# Compute type: int8 (best CPU speed) | int8_float16 | float16 (GPU) | float32 (slowest)
WHISPER_COMPUTE_TYPE=int8
# Language: leave unset / blank for auto-detect. Set to an ISO-639-1 code (e.g. 'en') to force.
# WHISPER_LANGUAGE=en
# Beam size (1-10, default 5). Higher = more accurate but slower.
WHISPER_BEAM_SIZE=5

# Minimum recording duration in seconds (default: 1.0, min: 0.1)
# Recordings shorter than this will not be processed
MIN_RECORDING_SECONDS=1.0

# Status Indicator Plugins (default: i3status)
# Comma-separated list of plugins to enable
# Available: i3status, gnome
#   i3status  -> writes status to a JSON file for i3bar to read
#   gnome     -> shows a colored tray icon in the GNOME top bar (AppIndicator)
# Multiple plugins can be enabled: STATUS_PLUGINS=i3status,gnome
# Example: STATUS_PLUGINS=i3status
STATUS_PLUGINS=i3status

# i3 Status Bar Plugin Configuration
# Path to the status file that i3bar will read (default: /tmp/voice2text_status)
# This file contains JSON in i3bar format with the current application status
# The file is automatically created and updated by the I3StatusPlugin
I3_STATUS_FILE=/tmp/voice2text_status

# GNOME Top-Bar Plugin Configuration
# Tray icon size in pixels (default: 64). Larger sizes render more crisply on
# HiDPI displays. Only used when 'gnome' is in STATUS_PLUGINS.
# Requires the 'pystray' package and a desktop that supports AppIndicator
# (on GNOME, install the 'AppIndicator and KStatusNotifierItem Support' extension).
GNOME_ICON_SIZE=64
